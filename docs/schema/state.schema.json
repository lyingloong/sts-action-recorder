{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actionrecorder:game-state:0.5",
  "title": "ActionRecorder 0.5 raw game_state",
  "type": "object",
  "required": ["screen_type", "screen_name", "is_screen_up", "room_phase", "action_phase", "room_type", "act", "floor", "class", "ascension_level", "current_hp", "max_hp", "gold", "act_boss", "keys", "deck", "relics", "potions", "map"],
  "properties": {
    "screen_type": {"type": ["string", "null"]},
    "screen_name": {"type": ["string", "null"]},
    "is_screen_up": {"type": ["boolean", "null"]},
    "room_phase": {"type": ["string", "null"]},
    "action_phase": {"type": ["string", "null"]},
    "room_type": {"type": ["string", "null"]},
    "act": {"type": ["integer", "null"]},
    "floor": {"type": ["integer", "null"]},
    "class": {"type": ["string", "null"]},
    "ascension_level": {"type": ["integer", "null"]},
    "current_hp": {"type": ["integer", "null"]},
    "max_hp": {"type": ["integer", "null"]},
    "gold": {"type": ["integer", "null"]},
    "act_boss": {"type": ["string", "null"]},
    "keys": {
      "type": ["object", "null"],
      "properties": {"ruby": {"type": ["boolean", "null"]}, "emerald": {"type": ["boolean", "null"]}, "sapphire": {"type": ["boolean", "null"]}},
      "additionalProperties": true
    },
    "deck": {"type": ["array", "null"], "items": {"type": "object"}},
    "relics": {"type": ["array", "null"], "items": {"type": "object"}},
    "potions": {"type": ["array", "null"], "items": {"type": "object"}},
    "map": {"type": ["array", "object", "null"]},
    "screen_state": {"type": ["object", "null"]},
    "choice_list": {"type": ["array", "null"]},
    "combat_state": {"type": ["object", "null"]},
    "seed": false
  },
  "allOf": [
    {"if": {"properties": {"screen_type": {"not": {"const": "MAP"}}}}, "then": {"properties": {"map": {"type": "null"}}}}
  ],
  "additionalProperties": true
}
