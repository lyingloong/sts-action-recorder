{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actionrecorder:game-state:0.5",
  "title": "ActionRecorder 0.5 raw game_state (Mod 0.1.5)",
  "type": "object",
  "required": ["screen_type", "screen_name", "is_screen_up", "room_phase", "action_phase", "room_type", "act", "floor", "class", "ascension_level", "current_hp", "max_hp", "gold", "act_boss", "keys", "deck", "relics", "potions", "map"],
  "properties": {
    "screen_type": {"type": ["string", "null"]},
    "screen_name": {"type": ["string", "null"]},
    "is_screen_up": {"type": ["boolean", "null"]},
    "room_phase": {"type": ["string", "null"]},
    "action_phase": {"type": ["string", "null"]},
    "room_type": {"type": ["string", "null"]},
    "act": {"type": ["integer", "null"]},
    "floor": {"type": ["integer", "null"]},
    "class": {"type": ["string", "null"]},
    "ascension_level": {"type": ["integer", "null"]},
    "current_hp": {"type": ["integer", "null"]},
    "max_hp": {"type": ["integer", "null"]},
    "gold": {"type": ["integer", "null"]},
    "act_boss": {"type": ["string", "null"]},
    "keys": {
      "type": ["object", "null"],
      "properties": {"ruby": {"type": ["boolean", "null"]}, "emerald": {"type": ["boolean", "null"]}, "sapphire": {"type": ["boolean", "null"]}},
      "additionalProperties": true
    },
    "deck": {"type": ["array", "null"], "items": {"$ref": "#/$defs/card"}},
    "relics": {"type": ["array", "null"], "items": {"$ref": "#/$defs/describedEntity"}},
    "potions": {"type": ["array", "null"], "items": {"$ref": "#/$defs/potion"}},
    "map": {"type": ["array", "object", "null"]},
    "screen_state": {
      "type": ["object", "null"],
      "properties": {
        "source_reward_id": {"type": ["string", "null"]},
        "rewards": {"type": ["array", "null"], "items": {
          "type": "object",
          "properties": {"reward_id": {"type": ["string", "null"]},
                         "reward_index": {"type": ["integer", "null"]},
                         "linked_reward_id": {"type": ["string", "null"]}},
          "additionalProperties": true
        }},
        "cards": {"$ref": "#/$defs/cards"},
        "hand": {"$ref": "#/$defs/cards"},
        "selected": {"$ref": "#/$defs/cards"},
        "selected_cards": {"$ref": "#/$defs/cards"},
        "match_game": {"$ref": "#/$defs/match_game"}
      },
      "additionalProperties": true
    },
    "choice_list": {"type": ["array", "null"]},
    "combat_state": {
      "type": ["object", "null"],
      "properties": {
        "player": {"$ref": "#/$defs/player"},
        "monsters": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {"powers": {"type": ["array", "null"], "items": {"$ref": "#/$defs/describedEntity"}}},
            "additionalProperties": true
          }
        },
        "hand": {"$ref": "#/$defs/cards"},
        "draw_pile": {"$ref": "#/$defs/cards"},
        "discard_pile": {"$ref": "#/$defs/cards"},
        "exhaust_pile": {"$ref": "#/$defs/cards"},
        "limbo": {"$ref": "#/$defs/cards"},
        "card_in_play": {"anyOf": [{"$ref": "#/$defs/card"}, {"type": "null"}]}
      },
      "additionalProperties": true
    },
    "seed": false
  },
  "allOf": [
    {"if": {"properties": {"screen_type": {"not": {"const": "MAP"}}}}, "then": {"properties": {"map": {"type": "null"}}}}
  ],
  "$defs": {
    "cards": {"type": ["array", "null"], "items": {"$ref": "#/$defs/card"}},
    "card": {
      "type": "object",
      "description": "Runtime card object. Added fields remain optional for older protocol-0.5 journals; audit_trace checks version-specific presence.",
      "properties": {
        "raw_description": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "description_source": {"type": ["string", "null"]},
        "description_complete": {"type": ["boolean", "null"]},
        "unresolved_description_variables": {"type": ["array", "null"], "items": {"type": "string"}},
        "multi_damage": {"type": ["array", "null"], "items": {"type": ["integer", "null"]}},
        "retain": {"type": ["boolean", "null"]},
        "self_retain": {"type": ["boolean", "null"]},
        "free_to_play_once": {"type": ["boolean", "null"]},
        "is_cost_modified": {"type": ["boolean", "null"]},
        "is_cost_modified_for_turn": {"type": ["boolean", "null"]},
        "is_innate": {"type": ["boolean", "null"]},
        "purge_on_use": {"type": ["boolean", "null"]},
        "exhaust_on_use_once": {"type": ["boolean", "null"]},
        "in_bottle_flame": {"type": ["boolean", "null"]},
        "in_bottle_lightning": {"type": ["boolean", "null"]},
        "in_bottle_tornado": {"type": ["boolean", "null"]}
      },
      "additionalProperties": true
    },
    "describedEntity": {
      "type": "object",
      "properties": {
        "raw_description": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "description_source": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "potion": {
      "type": "object",
      "properties": {
        "raw_description": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "description_source": {"type": ["string", "null"]},
        "target": {"type": ["boolean", "null"]},
        "tooltips": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {"header": {"type": ["string", "null"]}, "body": {"type": ["string", "null"]}},
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "player": {
      "type": ["object", "null"],
      "properties": {
        "powers": {"type": ["array", "null"], "items": {"$ref": "#/$defs/describedEntity"}},
        "base_energy_per_turn": {"type": ["integer", "null"]},
        "energy_per_turn": {"type": ["integer", "null"]},
        "master_hand_size": {"type": ["integer", "null"]},
        "game_hand_size": {"type": ["integer", "null"]},
        "cards_played_this_turn": {"type": ["integer", "null"]},
        "stance": {
          "type": ["object", "null"],
          "required": ["id", "name", "description"],
          "properties": {
            "id": {"type": ["string", "null"]},
            "name": {"type": ["string", "null"]},
            "description": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "match_game": {
      "type": ["object", "null"],
      "required": ["phase", "remaining_attempts", "matched_pairs", "game_done", "awaiting_resolution", "board", "selected_positions"],
      "properties": {
        "phase": {"type": ["string", "null"]},
        "remaining_attempts": {"type": ["integer", "null"]},
        "matched_pairs": {"type": ["integer", "null"]},
        "game_done": {"type": ["boolean", "null"]},
        "awaiting_resolution": {"type": ["boolean", "null"]},
        "selected_positions": {"type": ["array", "null"], "items": {"type": ["integer", "null"], "minimum": 0, "maximum": 11}},
        "board": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["position", "row", "column", "uuid", "face_up", "revealed", "matched", "card"],
            "properties": {
              "position": {"type": ["integer", "null"], "minimum": 0, "maximum": 11},
              "row": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
              "column": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
              "uuid": {"type": ["string", "null"]},
              "face_up": {"type": ["boolean", "null"]},
              "revealed": {"type": ["boolean", "null"]},
              "matched": {"type": ["boolean", "null"]},
              "card": {"anyOf": [{"$ref": "#/$defs/card"}, {"type": "null"}]}
            },
            "allOf": [{"if": {"properties": {"revealed": {"not": {"const": true}}}}, "then": {"properties": {"card": {"type": "null"}}}}],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
