<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>action-recorder</groupId>
    <artifactId>action-recorder</artifactId>
    <version>0.1.6-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>StS Action Recorder</name>
    <description>High-level in-game decision event recorder for Slay the Spire.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!-- Steam.path is supplied at build time with -DSteam.path=... . -->
        <SlayTheSpire.version>12-22-2020</SlayTheSpire.version>
        <ModTheSpire.version>3.23.2</ModTheSpire.version>
        <BaseMod.version>5.33.1</BaseMod.version>
        <!-- Skip only the package-time installation, never test validation. -->
        <actionrecorder.install.skip>false</actionrecorder.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.megacrit.cardcrawl</groupId>
            <artifactId>slaythespire</artifactId>
            <version>${SlayTheSpire.version}</version>
            <scope>system</scope>
            <systemPath>${Steam.path}/common/SlayTheSpire/desktop-1.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>basemod</groupId>
            <artifactId>basemod</artifactId>
            <version>${BaseMod.version}</version>
            <scope>system</scope>
            <systemPath>${Steam.path}/workshop/content/646570/1605833019/BaseMod.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.evacipated.cardcrawl</groupId>
            <artifactId>ModTheSpire</artifactId>
            <version>${ModTheSpire.version}</version>
            <scope>system</scope>
            <systemPath>${Steam.path}/workshop/content/646570/1605060445/ModTheSpire.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.8</version>
                <executions>
                    <execution>
                        <id>verify-communication-bytecode</id>
                        <phase>test</phase>
                        <configuration>
                            <skip>${maven.test.skip}</skip>
                            <target>
                                <java classname="actionrecorder.PatchBindingSmoke"
                                      fork="true" failonerror="true">
                                    <classpath>
                                        <path refid="maven.test.classpath"/>
                                        <pathelement location="${Steam.path}/workshop/content/646570/2131373661/CommunicationMod.jar"/>
                                    </classpath>
                                </java>
                                <java classname="actionrecorder.PatchInstrumentationSmoke"
                                      fork="true" failonerror="true">
                                    <classpath>
                                        <path refid="maven.test.classpath"/>
                                        <pathelement location="${Steam.path}/workshop/content/646570/2131373661/CommunicationMod.jar"/>
                                    </classpath>
                                </java>
                                <java classname="actionrecorder.CommunicationSerializationSmoke"
                                      fork="true" failonerror="true">
                                    <arg value="--if-installed"/>
                                    <classpath>
                                        <path refid="maven.test.classpath"/>
                                        <pathelement location="${Steam.path}/workshop/content/646570/2131373661/CommunicationMod.jar"/>
                                    </classpath>
                                </java>
                                <java classname="actionrecorder.QueuedDecisionTrackerSmoke"
                                      fork="true" failonerror="true">
                                    <classpath><path refid="maven.test.classpath"/></classpath>
                                </java>
                                <java classname="actionrecorder.RuntimeStateFieldsSmoke"
                                      fork="true" failonerror="true">
                                    <classpath><path refid="maven.test.classpath"/></classpath>
                                </java>
                                <java classname="actionrecorder.JournalIdentitySmoke"
                                      fork="true" failonerror="true">
                                    <classpath><path refid="maven.test.classpath"/></classpath>
                                </java>
                                <java classname="actionrecorder.runtime.CommunicationSnapshotSmoke"
                                      fork="true" failonerror="true">
                                    <classpath><path refid="maven.test.classpath"/></classpath>
                                </java>
                                <java classname="actionrecorder.DecisionStateSmoke"
                                      fork="true" failonerror="true">
                                    <classpath><path refid="maven.test.classpath"/></classpath>
                                </java>
                                <java classname="actionrecorder.CampfireOptionsSmoke"
                                      fork="true" failonerror="true">
                                    <classpath><path refid="maven.test.classpath"/></classpath>
                                </java>
                                <java classname="actionrecorder.runtime.GridCardPreviewsSmoke"
                                      fork="true" failonerror="true">
                                    <classpath><path refid="maven.test.classpath"/></classpath>
                                </java>
                                <java classname="actionrecorder.RuntimeDescriptionsSmoke"
                                      fork="true" failonerror="true">
                                    <classpath><path refid="maven.test.classpath"/></classpath>
                                </java>
                                <java classname="actionrecorder.CommandLedgerSmoke"
                                      fork="true" failonerror="true">
                                    <classpath>
                                        <path refid="maven.test.classpath"/>
                                        <pathelement location="${Steam.path}/workshop/content/646570/2131373661/CommunicationMod.jar"/>
                                    </classpath>
                                </java>
                                <java classname="actionrecorder.CommunicationBytecodeSmoke"
                                      fork="true" failonerror="true">
                                    <jvmarg value="-Xverify:all"/>
                                    <arg value="--if-installed"/>
                                    <classpath>
                                        <path refid="maven.test.classpath"/>
                                        <pathelement location="${Steam.path}/workshop/content/646570/2131373661/CommunicationMod.jar"/>
                                    </classpath>
                                </java>
                            </target>
                        </configuration>
                        <goals><goal>run</goal></goals>
                    </execution>
                    <execution>
                        <id>install-local-mod</id>
                        <phase>package</phase>
                        <configuration>
                            <skip>${actionrecorder.install.skip}</skip>
                            <target>
                                <copy file="target/${project.artifactId}.jar"
                                      tofile="${Steam.path}/common/SlayTheSpire/mods/${project.artifactId}.jar"/>
                            </target>
                        </configuration>
                        <goals><goal>run</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
